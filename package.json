{
  "name": "kernelbase-ide",
  "productName": "Kernel Base",
  "private": true,
  "version": "0.1.0",
  "description": "Kernel Base AI-Native Multi-Agent Integrated Development Environment for macOS",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Kernel Base Team",
  "homepage": "https://github.com/Sujoymoulick/KERNELBASE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sujoymoulick/KERNELBASE.git"
  },
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"VITE,ELECTRON\" -c \"cyan,magenta\" \"vite --port=3000\" \"tsx scripts/build-electron.ts && electron dist-electron/main.cjs\"",
    "build": "npm run build:electron && npm run build:renderer",
    "build:electron": "tsx scripts/build-electron.ts",
    "build:renderer": "vite build",
    "preview": "vite preview",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:mac": "electron-forge make --platform=darwin --arch=arm64",
    "test": "tsx scripts/test-ide.ts",
    "clean": "rm -rf dist dist-electron out"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/diff": "^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "diff": "^7.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "mermaid": "^12.0.0",
    "monaco-editor": "^0.52.2",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/maker-dmg": "^7.8.1",
    "@electron-forge/maker-zip": "^7.8.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "electron": "^34.3.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
