{
  "name": "kernelbase-ide",
  "productName": "Kernel Base",
  "private": true,
  "version": "1.0.0",
  "description": "Kernel Base AI-Native Multi-Agent Integrated Development Environment for macOS",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Kernel Base Team",
  "homepage": "https://github.com/Sujoymoulick/kernelbase-docs",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sujoymoulick/kernelbase-docs.git"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "keywords": [
    "kernelbase",
    "ai-native-ide",
    "multi-agent",
    "agentic-workflow",
    "mcp",
    "litellm",
    "ollama",
    "dag-orchestration",
    "react19",
    "typescript",
    "tailwind-v4",
    "documentation",
    "electron",
    "macos"
  ],
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --port=3000 --host=0.0.0.0",
    "dev:desktop": "concurrently -k -p \"[{name}]\" -n \"VITE,ELECTRON\" -c \"cyan,magenta\" \"vite --port=3000\" \"node ./node_modules/tsx/dist/cli.mjs scripts/build-electron.ts && electron dist-electron/main.cjs\"",
    "build": "npm run build:electron && npm run build:renderer",
    "build:electron": "node ./node_modules/tsx/dist/cli.mjs scripts/build-electron.ts",
    "build:renderer": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "clean": "rm -rf dist dist-electron out",
    "lint": "node ./node_modules/typescript/bin/tsc --noEmit",
    "electron:start": "node ./node_modules/tsx/dist/cli.mjs scripts/build-electron.ts && node ./node_modules/electron/cli.js dist-electron/main.cjs",
    "package": "node ./node_modules/tsx/dist/cli.mjs scripts/package-mac.ts",
    "make": "node ./node_modules/tsx/dist/cli.mjs scripts/package-mac.ts",
    "make:mac": "node ./node_modules/tsx/dist/cli.mjs scripts/package-mac.ts",
    "make:linux": "node ./node_modules/tsx/dist/cli.mjs scripts/package-linux.ts",
    "test": "node ./node_modules/tsx/dist/cli.mjs scripts/test-ide.ts",
    "validate:desktop": "node ./node_modules/tsx/dist/cli.mjs scripts/validate-desktop.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/diff": "^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/xterm": "^5.5.0",
    "diff": "^7.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.13.0",
    "marked": "16.4.2",
    "mermaid": "^12.0.0",
    "monaco-editor": "^0.52.2",
    "motion": "^12.23.24",
    "node-pty": "1.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "unpdf": "^2.1.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/maker-dmg": "^7.8.1",
    "@electron-forge/maker-zip": "^7.8.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "electron": "^34.3.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
